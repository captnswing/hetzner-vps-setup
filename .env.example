# Copy this file to `.env` and fill it in:
#
#   cp .env.example .env
#
# `.env` is gitignored, so your values are never committed, and the scripts load it
# automatically. README → "One-time setup" explains where each value comes from.
# Check your setup with `make doctor`.

# --- Required ----------------------------------------------------------------

# Hetzner Cloud API token (Read & Write).
# console.hetzner.cloud → your project → Security → API tokens → Generate API token
HCLOUD_TOKEN=

# Tailscale OAuth client, used to create a single-use key for each new server.
# login.tailscale.com/admin → Settings → Trust credentials → Credential → OAuth
# (scope: Auth Keys → Write, tag: tag:vps). README step 4 has the details.
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=

# --- Optional ----------------------------------------------------------------

# GitHub classic token, to log the server's `gh` CLI and Docker into GitHub/GHCR.
# github.com/settings/tokens → Tokens (classic); scopes: repo, read:org, read:packages
# Sent over SSH after setup; it is never stored in the server's cloud-init data.
GITHUB_TOKEN=

# Name of the SSH key in your Hetzner project. Leave blank for the default
# ("Hetzner Automation Key"); the script creates and uploads it on first run.
SSH_KEY_NAME=

# Public key text to upload when that Hetzner key doesn't exist yet. Leave blank and
# the script uses ~/.ssh/Hetzner_Automation_Key.pub, or offers to generate a keypair.
PUB_KEY=

# Instead of the OAuth client: a reusable, tag:vps-tagged auth key. Not recommended —
# it stays readable on every server it was used for, until it expires.
TAILSCALE_AUTH_KEY=
